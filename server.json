{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-09-29/server.schema.json",
  "name": "com.binggio/binggio",
  "title": "Binggio",
  "description": "Governed answers from your data: approved meanings only, refusals instead of guesses.",
  "repository": {
    "url": "https://github.com/binggio/binggio",
    "source": "github"
  },
  "websiteUrl": "https://www.binggio.com",
  "version": "0.1.1",
  "packages": [
    {
      "registryType": "pypi",
      "identifier": "binggio",
      "version": "0.1.1",
      "runtimeHint": "uvx",
      "transport": {
        "type": "stdio"
      },
      "packageArguments": [
        {
          "type": "positional",
          "value": "mcp"
        }
      ],
      "environmentVariables": [
        {
          "name": "BINGGIO_WORKSPACE",
          "description": "Folder of your Binggio workspace (the one containing binggio.json)",
          "isRequired": true,
          "format": "filepath"
        }
      ]
    }
  ]
}
