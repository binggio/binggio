 {
  "id": "Q3",
  "question": "risk>50 + open account + any complaint, no escalated ticket",
  "plans": [
   {
    "entity": "csv_clean::customer_master",
    "select": [
     "csv_clean::customer_master::CUSTOMER_ID"
    ],
    "exists": [
     {
      "table": "csv_clean::risk_assessments",
      "filters": [
       {
        "field": "csv_clean::risk_assessments::RISK_SCORE",
        "op": "gt",
        "value": 50
       }
      ],
      "negate": false
     },
     {
      "table": "sqlite_imperfect::account_master",
      "filters": [
       {
        "field": "sqlite_imperfect::account_master::STATUS",
        "op": "eq",
        "value": "OPEN"
       }
      ],
      "negate": false
     },
     {
      "table": "sqlite_imperfect::complaint_log",
      "filters": [],
      "negate": false
     },
     {
      "table": "sqlite_imperfect::service_tickets",
      "filters": [
       {
        "field": "sqlite_imperfect::service_tickets::TICKET_STATUS",
        "op": "eq",
        "value": "ESCALATED"
       }
      ],
      "negate": true
     }
    ]
   }
  ],
  "expected": [
