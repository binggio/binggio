[
 {
  "id": "Q1",
  "question": "PREMIUM + delinquent loan + escalated complaint",
  "plans": [
   {
    "entity": "csv_clean::customer_master",
    "select": [
     "csv_clean::customer_master::CUSTOMER_ID",
     "csv_clean::customer_master::CUSTOMER_NAME"
    ],
    "filters": [
     {
      "field": "csv_clean::customer_master::SEGMENT",
      "op": "eq",
      "value": "PREMIUM"
     }
    ],
    "terms": [
     {
      "term": "term:eb76e7c3a9054d0c8dbc5bfc0aca9227",
      "negate": false
     }
    ],
    "exists": [
     {
      "table": "sqlite_imperfect::complaint_log",
      "filters": [
       {
        "field": "sqlite_imperfect::complaint_log::STATUS",
        "op": "eq",
        "value": "ESCALATED"
       }
      ],
      "negate": false
     }
    ]
   }
  ],
  "expected": [
   "C0014",
   "C0026",
   "C0030",
   "C0058",
   "C0070",
   "C0102",
   "C0106",
   "C0118"
  ]
 },
