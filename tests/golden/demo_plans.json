 {
  "id": "Q7",
  "question": "customers with a delinquent loan, per segment",
  "plans": [
   {
    "entity": "csv_clean::customer_master",
    "aggregate": [
     {
      "fn": "count_distinct",
      "field": "csv_clean::customer_master::CUSTOMER_ID",
      "alias": "customers"
     }
    ],
    "group_by": [
     "csv_clean::customer_master::SEGMENT"
    ],
    "terms": [
     {
      "term": "term:eb76e7c3a9054d0c8dbc5bfc0aca9227",
      "negate": false
     }
    ]
   }
  ],
  "expected": {
   "CORPORATE": 7,
   "PREMIUM": 11,
   "RETAIL": 10,
   "STANDARD": 8
  }
 },
